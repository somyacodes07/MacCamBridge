{
  "name": "maccam-bridge-windows-receiver",
  "version": "1.0.0",
  "description": "MacCam Bridge Cross-Platform Suite — Low latency MacBook camera & receiver for Windows 11",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.maccambridge.windows",
    "productName": "MacCam Bridge",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "keywords": [
    "maccam-bridge",
    "webcam",
    "streaming",
    "h264",
    "virtual-camera",
    "obs",
    "discord",
    "whatsapp",
    "windows11"
  ],
  "author": "somyacodes07",
  "license": "MIT",
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.9.0"
  }
}
