{
  "name": "maccam-bridge-windows-receiver",
  "version": "1.0.0",
  "description": "MacCam Bridge Cross-Platform Suite — Low latency MacBook camera & receiver for Windows 11",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "build:exe": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.maccambridge.windows",
    "productName": "MacCam Bridge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "mcb_protocol_decoder.js",
      "obs_virtual_cam_bridge.py",
      "icon.ico"
    ],
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MacCam Bridge"
    },
    "portable": {
      "artifactName": "${productName}-Windows-Portable-${version}.${ext}"
    }
  },
  "keywords": [
    "maccam-bridge",
    "webcam",
    "streaming",
    "h264",
    "virtual-camera",
    "obs",
    "discord",
    "whatsapp",
    "windows11"
  ],
  "author": "somyacodes07",
  "license": "MIT",
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.9.0"
  }
}
